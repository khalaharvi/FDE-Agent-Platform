{% extends "base.html.j2" %}
{% import "_fields.html.j2" as fields_macro %}
{% block title %}Runs{% endblock %}
{% block content %}
<h1>Runs</h1>
<p class="muted">
  {% if status %}Showing <strong>{{ status }}</strong>. <a href="/ui/runs">all</a>
  {% else %}Showing all.{% endif %}
  &middot; <a href="/ui/runs?status=awaiting_human">awaiting a human</a>
  &middot; <a href="/ui/runs?status=failed">failed</a>
  &middot; <a href="/ui/runs?status=running">running</a>
</p>

<h2>Start a run</h2>
{% if not workflows %}
  <p class="empty">No published workflow to run. Publish one first.</p>
{% else %}
{# Choosing the workflow is a GET, because which fields the run needs depends
   on which workflow it is and this console has no JavaScript. The cost is a
   second click; what it buys is that the second step is a form instead of a
   box asking a non-technical operator to type JSON. #}
<form method="get" action="/ui/runs">
  <fieldset>
    <legend>New run</legend>
    {# `pick_`, not `f_`: generated controls take their id from
       `Field.input_name`, so `f_` is theirs in the id namespace too and a
       schema field named `workflow` would render a second element with this
       one's id. See `_fields.html.j2`. #}
    <div class="field">
      <label for="pick_workflow">Workflow</label>
      <select id="pick_workflow" name="workflow_id" required>
        <option value="">— choose —</option>
        {% for w in workflows %}
          <option value="{{ w.workflow_id }}"{% if selected_workflow and w.workflow_id == selected_workflow.workflow_id %} selected{% endif %}>{{ w.title }} ({{ w.slug }} v{{ w.version }})</option>
        {% endfor %}
      </select>
    </div>
    {% if status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}
    <button type="submit">Choose</button>
  </fieldset>
</form>

{% if selected_workflow %}
<form method="post" action="/ui/runs/start">
  <input type="hidden" name="workflow_id" value="{{ selected_workflow.workflow_id }}">
  <fieldset>
    <legend>Input for {{ selected_workflow.title }}</legend>
    {% if input_fields %}
      <p class="muted">
        These fields come from the answer shape step
        <code>{{ input_schema_step.step_key }}</code> ({{ input_schema_step.title }})
        declares. It is the nearest thing this workflow writes down about its
        own input -- check them against what the first step expects.
      </p>
      {% for f in input_fields %}
        {{ fields_macro.field(f) }}
      {% endfor %}
    {% else %}
      {# The labelled fallback. No step of this workflow declares a
         human_schema, so there is nothing to generate fields from and
         guessing would be worse than saying so. #}
      <p class="muted">
        This workflow declares no input shape, so there are no fields to
        generate. Give the input as a JSON object, or leave it empty.
      </p>
      <label style="display:block" for="start_input">Input (JSON object, becomes <code>$.input</code> in the run context):
        <textarea id="start_input" name="input" placeholder="{}"></textarea>
      </label>
    {% endif %}
    <button type="submit">Start</button>
  </fieldset>
</form>
{% endif %}
{% endif %}

<h2>Runs ({{ runs | length }})</h2>
{% if not runs %}
  <p class="empty">No runs yet.</p>
{% else %}
<table>
  <tr><th>Run</th><th>Workflow</th><th>Status</th><th>Current step</th>
      <th>Started by</th><th>Started</th></tr>
  {% for r in runs %}
  <tr>
    <td><a href="/ui/runs/{{ r.run_id }}">#{{ r.run_id }}</a></td>
    <td>{{ r.workflow_title }}<div class="muted">{{ r.workflow_slug }}</div></td>
    <td><span class="pill">{{ r.status }}</span></td>
    <td>{{ r.current_step_key or "—" }}
        {% if r.current_step_kind %}<span class="muted">({{ r.current_step_kind }})</span>{% endif %}</td>
    <td>{{ r.started_by }}</td>
    <td>{{ r.started_at }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{# Launches are not runs and this section does not pretend they are: a launch
   has no workflow, no steps and no pinned commit. It is here because it
   answers the same question one table down -- what did I set going, and how
   did it end -- and because the operator who needs it is the one whose
   browser gave up on a launch, who has no reason to go looking anywhere
   else. Deliberately unfiltered by `?status=`: those values are
   `wf.run_status` members and a launch can be none of them. #}
<h2>Agent launches ({{ launches | length }})</h2>
<p class="muted">
  Tasks started from <a href="/ui/agents/run">Run an agent</a>. The console
  records each one before it dispatches, so a launch whose page timed out
  still shows up here. What the agent PROPOSED is on the
  <a href="/ui">review queue</a> — this is the record of the asking.
</p>
{% if not launches %}
  <p class="empty">No agent has been launched from the console yet.</p>
{% else %}
<table>
  <tr><th>Launch</th><th>Agent &middot; task</th><th>Status</th>
      <th>Launched by</th><th>Requested</th><th>Finished</th></tr>
  {% for l in launches %}
  <tr>
    <td>#{{ l.launch_id }}</td>
    <td>{{ l.agent }} &middot; {{ l.task }}
        <div class="muted">{{ l.engagement_id }}</div></td>
    <td><span class="pill">{{ l.status }}</span>
        {% if l.status == 'running' %}
          {# The honest reading of the state this table exists for. A row can
             sit here because the agent is still working, or because whatever
             was waiting for it is gone; from the database the two are the
             same row, so the page says both rather than picking one. #}
          <div class="muted">nothing has reported back yet — still working, or
            the request that was waiting for it is gone</div>
        {% elif l.status == 'queued' %}
          <div class="muted">accepted, not yet dispatched</div>
        {% endif %}
        {% if l.error %}<div class="muted">{{ l.error | error_text }}</div>{% endif %}</td>
    <td>{{ l.principal }}</td>
    <td>{{ l.requested_at }}</td>
    <td>{{ l.completed_at or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% endblock %}
