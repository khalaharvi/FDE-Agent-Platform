{# Page chrome for the whole console. One stylesheet, inline, because a
   second request for a static asset would mean an S3 bucket, a bucket
   policy, and a cache-invalidation story for about 60 lines of CSS. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}FDE prod-ops{% endblock %}</title>
  <style>
    :root { color-scheme: light dark; }
    body { font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, sans-serif;
           margin: 0; padding: 0 0 4rem; }
    header { display: flex; gap: 1rem; align-items: baseline; flex-wrap: wrap;
             padding: .75rem 1.5rem; border-bottom: 1px solid #8884; }
    header nav a { margin-right: .9rem; text-decoration: none; }
    header .who { margin-left: auto; opacity: .7; font-size: .85em; }
    main { padding: 1.25rem 1.5rem; max-width: 76rem; }
    h1 { font-size: 1.35rem; margin: 0 0 .25rem; }
    h2 { font-size: 1.1rem; margin: 1.75rem 0 .5rem; }
    h3 { font-size: .95rem; margin: 1.25rem 0 .4rem; }
    table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; }
    th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid #8883;
             vertical-align: top; }
    th { font-weight: 600; font-size: .8rem; text-transform: uppercase;
         letter-spacing: .04em; opacity: .75; }
    pre { background: #8881; padding: .6rem; border-radius: 4px; overflow-x: auto;
          font-size: .82rem; margin: .3rem 0; }
    form { margin: .5rem 0; }
    fieldset { border: 1px solid #8884; border-radius: 5px; margin: .75rem 0; padding: .75rem 1rem; }
    legend { font-weight: 600; font-size: .85rem; padding: 0 .35rem; }
    label { display: inline-block; margin: .2rem .6rem .2rem 0; font-size: .88rem; }
    /* Generated forms (_fields.html.j2): one control per row, its label above
       it and its hint below. Inline labels work for the two-field forms that
       were here first; a generated form can be eight fields long, and eight
       controls flowing inline is a wall nobody reads to the end of. */
    .field { margin: .6rem 0; max-width: 46rem; }
    .field > label { display: block; font-weight: 600; margin-bottom: .15rem; }
    .field .hint { font-size: .8rem; margin-top: .15rem; }
    .field .req { color: #c62828; }
    .field input[type=text], .field input[type=number], .field select { width: 100%; }
    textarea { width: 100%; min-height: 4.5rem; font-family: ui-monospace, monospace;
               font-size: .82rem; }
    input[type=text], select, textarea { padding: .25rem; }
    button { padding: .35rem .8rem; font: inherit; cursor: pointer; }
    .banner { padding: .6rem 1rem; border-radius: 4px; margin: .75rem 0; }
    .banner.error { background: #d3202020; border: 1px solid #d32020aa; }
    .banner.notice { background: #20a05020; border: 1px solid #20a050aa; }
    /* Louder than a notice, and not an error: nothing has failed when a
       source ingests with no anchors -- it is just about to be useless, and
       the operator has one thing to do about it. A thick left rule is what
       makes it read as blocking without lying about a failure. */
    .banner.warn { background: #e8930020; border: 1px solid #e89300aa;
                   border-left-width: 5px; }
    .banner.warn p { margin: .4rem 0 0; }
    .pill { display: inline-block; padding: .05rem .45rem; border-radius: 999px;
            border: 1px solid #8886; font-size: .78rem; }
    .muted { opacity: .65; }
    .overdue { color: #c62828; font-weight: 600; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
    .empty { padding: 1rem; opacity: .7; font-style: italic; }
  </style>
</head>
<body>
<header>
  <strong>FDE prod-ops</strong>
  <nav>
    <a href="/ui">Review queue</a>
    <a href="/ui/sources">Sources</a>
    <a href="/ui/agents/run">Run an agent</a>
    <a href="/ui/workflows">Workflows</a>
    <a href="/ui/runs">Runs</a>
    <a href="/ui/drift">Drift</a>
    {# Shown to administrators only. The page refuses everyone else on its
       own (service/reviewers.py), so this hides a door rather than locking
       one -- an operator who bookmarks the URL still gets a 403. #}
    {% if is_admin %}<a href="/ui/reviewers">Reviewers</a>{% endif %}
  </nav>
  <span class="who">{{ principal or "unauthenticated" }}</span>
</header>
<main>
  {% if error %}<div class="banner error">{{ error }}</div>{% endif %}
  {% if notice %}<div class="banner notice">{{ notice }}</div>{% endif %}
  {% block content %}{% endblock %}
</main>
</body>
</html>
